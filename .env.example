# Copy to root .env for a new checkout. Never commit real secrets.
PGHOST=localhost
PGPORT=5432
PGDATABASE=hackloop
PGUSER=postgres
PGPASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD
PUBLIC_APP_URL=http://localhost:5174

# Server-side verification email and password-reset sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# OAuth credentials, not SMTP app passwords.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Select a Gemini model supported by your key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODELS=
AI_REQUEST_TIMEOUT_SECONDS=60
